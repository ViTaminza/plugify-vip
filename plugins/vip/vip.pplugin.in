			"group": "menus",
			"description": "Opens the VIP menu of a player (the ShowVIPMenu of the original, bReopen = true). Does nothing for a player without access.",
			"paramTypes": [
				{
					"name": "slot",
					"type": "int32",
					"ref": false,
					"description": "Player slot."
				}
			],
			"retType": {
				"type": "void"
			}
		},
